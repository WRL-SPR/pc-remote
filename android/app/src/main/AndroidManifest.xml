<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates: hand the downloaded APK to the system installer (user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: lets us find and launch Artemis / Moonlight. -->
    <queries>
        <package android:name="com.limelight.noir" />
        <package android:name="com.limelight.root.noir" />
        <package android:name="com.limelight" />
        <package android:name="com.limelight.unofficial" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcRemote"
        android:usesCleartextTraffic="true">
        <!-- Fold/unfold, rotation and pop-up/split view are handled by Compose without
             recreating the activity, so boot tracking in progress is not lost. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Runs a power action without UI. Reached through the aliases below and app shortcuts. -->
        <activity
            android:name=".ActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- One app-list entry per action, off by default and switched on from the app's settings,
             so Modes & Routines ("앱 열기") and Bixby ("PC 끄기 열어줘") can start them. -->
        <activity-alias
            android:name=".action.Wake"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_action_wake"
            android:label="@string/action_wake"
            android:targetActivity=".ActionActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".action.Sleep"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_action_sleep"
            android:label="@string/action_sleep"
            android:targetActivity=".ActionActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".action.Hibernate"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_action_hibernate"
            android:label="@string/action_hibernate"
            android:targetActivity=".ActionActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".action.Restart"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_action_restart"
            android:label="@string/action_restart"
            android:targetActivity=".ActionActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".action.Shutdown"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_action_shutdown"
            android:label="@string/action_shutdown"
            android:targetActivity=".ActionActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
