<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ package visibility: lets us find and launch Artemis / Moonlight. -->
    <queries>
        <package android:name="com.limelight.noir" />
        <package android:name="com.limelight.root.noir" />
        <package android:name="com.limelight" />
        <package android:name="com.limelight.unofficial" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcRemote"
        android:usesCleartextTraffic="true">
        <!-- Fold/unfold, rotation and pop-up/split view are handled by Compose without
             recreating the activity, so boot tracking in progress is not lost. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
